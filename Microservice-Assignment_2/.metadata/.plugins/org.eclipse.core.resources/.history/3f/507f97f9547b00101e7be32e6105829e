package com.example.api_gateway;

import org.springframework.boot.SpringApplication;
import org.springframework.cloud.client.discovery.EnableDiscoveryClient;
import org.springframework.context.annotation.Bean;
import org.springframework.cloud.gateway.route.RouteLocator;
import org.springframework.cloud.gateway.route.builder.RouteLocatorBuilder;
import org.springframework.context.annotation.Bean;


import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;

@SpringBootApplication
public class ApiGatewayApplication {

	public static void main(String[] args) {
		SpringApplication.run(ApiGatewayApplication.class, args);
	}
	
	@Bean
    public RouteLocator routes(RouteLocatorBuilder builder) {
        return builder.routes()
                .route("doctor-service", r -> r.path("/api/doctors/**")
                        .uri("http://localhost:2222"))
                .route("appointment_service", r -> r.path("/api/appointments/**")
                        .uri("http://localhost:3333"))
                .route("billing-service", r -> r.path("/api/bills/**")
                        .uri("http://localhost:5555"))
                .route("medical-records-service", r -> r.path("/api/medical-records/**")
                        .uri("http://localhost:4444"))
                .route("patient-service", r -> r.path("/api/patient-service/**")
                        .uri("http://localhost:4444"))
                .build();
    } 	
}
